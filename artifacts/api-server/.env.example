# The content is saved to data/portfolio-content.json by default. Set this only
# if you want the file elsewhere.
# CONTENT_STORE_PATH=/absolute/path/to/portfolio-content.json

# Keep this set to 2005 for the requested default, or change it later.
ADMIN_PASSWORD=2005
ADMIN_SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Required by the API server.
PORT=3000
